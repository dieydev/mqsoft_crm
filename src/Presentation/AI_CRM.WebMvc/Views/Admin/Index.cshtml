<!-- SMART ALERTS ROW: EXPIRING CONTRACTS & ATTENTION PROJECTS -->
<div class="row g-4 mb-4">
    <!-- Cảnh báo Hợp đồng & Bảo hành sắp hết hạn -->
    <div class="col-12 col-lg-6">
        <div class="glass-card p-4 h-100 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="stat-icon bg-danger-light" style="width: 34px; height: 34px; font-size: 1rem;">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Cảnh báo Hợp đồng & Bảo hành</h6>
                        <small class="text-muted">Cần chú ý tái ký hoặc thu công nợ bảo trì</small>
                    </div>
                </div>
                <a asp-controller="Contract" asp-action="Index" class="btn btn-sm btn-link text-primary text-decoration-none fw-medium">
                    Xem tất cả <i class="fa-solid fa-chevron-right ms-1 small"></i>
                </a>
            </div>

            @if (expiringContracts != null && expiringContracts.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var c in expiringContracts)
                    {
                        int daysRemaining = c.ExpireDate.HasValue ? (c.ExpireDate.Value.Date - today).Days : 999;
                        string badgeClass = daysRemaining < 0 ? "urgent" : (daysRemaining <= 30 ? "urgent" : "warning");
                        string pulseClass = daysRemaining <= 30 ? "pulse-danger" : "pulse-warning";
                        string statusText = daysRemaining < 0 ? $"Quá hạn {Math.Abs(daysRemaining)} ngày" : (daysRemaining == 0 ? "Hết hạn hôm nay!" : $"Còn {daysRemaining} ngày");

                        <div class="smart-alert-card p-3 @(daysRemaining <= 30 ? "alert-danger-accent" : "alert-warning-accent")">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge-countdown @badgeClass">
                                            <span class="pulse-dot @pulseClass"></span>@statusText
                                        </span>
                                        <span class="badge bg-light text-dark fw-bold border">@(c.ContractNumber ?? "HĐ-N/A")</span>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.95rem;">
                                        @(c.KhachHang?.CompanyName ?? c.ContractName ?? "Khách hàng y tế")
                                    </h6>
                                    <div class="text-muted small d-flex flex-wrap align-items-center gap-3">
                                        <span><i class="fa-regular fa-calendar-xmark me-1 text-danger"></i>Hết hạn: @(c.ExpireDate?.ToString("dd/MM/yyyy") ?? "Chưa rõ")</span>
                                        @if (c.ContractValue.HasValue)
                                        {
                                            <span><i class="fa-solid fa-money-bill-wave me-1 text-success"></i>@((c.ContractValue.Value).ToString("N0")) VNĐ</span>
                                        }
                                    </div>
                                </div>
                                <a asp-controller="Contract" asp-action="Details" asp-route-id="@c.ContractId" class="btn btn-sm btn-outline-primary rounded-pill px-3 flex-shrink-0">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="fa-solid fa-circle-check text-success fs-1 mb-2"></i>
                    <p class="mb-0 fw-medium">Không có hợp đồng nào sắp hết hạn trong 60 ngày tới.</p>
                </div>
            }
        </div>
    </div>

    <!-- Cảnh báo Dự án cần chú ý / Tiến độ triển khai -->
    <div class="col-12 col-lg-6">
        <div class="glass-card p-4 h-100 border-0 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="stat-icon bg-warning-light" style="width: 34px; height: 34px; font-size: 1rem;">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </span>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Tiến độ Dự án Cần Chú Ý</h6>
                        <small class="text-muted">Theo dõi deadline và tiến độ triển khai thực tế</small>
                    </div>
                </div>
                <a asp-controller="Project" asp-action="Index" class="btn btn-sm btn-link text-primary text-decoration-none fw-medium">
                    Xem tất cả <i class="fa-solid fa-chevron-right ms-1 small"></i>
                </a>
            </div>

            @if (attentionProjects != null && attentionProjects.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var p in attentionProjects)
                    {
                        var latestProgress = p.TienDoDuAns?.OrderByDescending(t => t.UpdateDate).FirstOrDefault()?.ProgressPercent ?? 0;
                        bool isOverdue = p.Deadline.HasValue && p.Deadline.Value.Date < today && latestProgress < 100;
                        int daysDiff = p.Deadline.HasValue ? (p.Deadline.Value.Date - today).Days : 999;
                        
                        string progressColor = latestProgress >= 80 ? "bg-success" : (latestProgress >= 50 ? "bg-primary" : (latestProgress >= 25 ? "bg-warning" : "bg-danger"));

                        <div class="smart-alert-card p-3 @(isOverdue ? "alert-danger-accent" : "alert-info-accent")">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.95rem;">
                                        @p.ProjectName
                                    </h6>
                                    <div class="text-muted small">
                                        <i class="fa-solid fa-hospital me-1 text-primary"></i>@(p.KhachHang?.CompanyName ?? "Chưa gán khách hàng")
                                    </div>
                                </div>
                                <div class="text-end">
                                    @if (isOverdue)
                                    {
                                        <span class="badge-countdown urgent">
                                            <span class="pulse-dot pulse-danger"></span>Trễ @Math.Abs(daysDiff) ngày
                                        </span>
                                    }
                                    else if (daysDiff <= 14 && daysDiff >= 0)
                                    {
                                        <span class="badge-countdown warning">
                                            <i class="fa-regular fa-clock me-1"></i>Hạn: @(p.Deadline?.ToString("dd/MM") ?? "N/A")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border">@(p.TrangThaiDuAn?.StatusName ?? "Đang chạy")</span>
                                    }
                                </div>
                            </div>
                            
                            <!-- Progress Bar -->
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <div class="progress-custom flex-grow-1">
                                    <div class="progress-bar @progressColor" role="progressbar" style="width: @latestProgress%;" aria-valuenow="@latestProgress" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <span class="fw-bold small text-dark" style="min-width: 40px; text-align: right;">@latestProgress%</span>
                                <a asp-controller="Project" asp-action="Details" asp-route-id="@p.ProjectId" class="btn btn-sm btn-light border py-0 px-2 rounded-pill small ms-1" title="Chi tiết">
                                    <i class="fa-solid fa-arrow-right text-muted"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="fa-solid fa-list-check text-primary fs-1 mb-2"></i>
                    <p class="mb-0 fw-medium">Tất cả dự án đang hoàn thành đúng tiến độ đề ra.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- CHARTS & ACTIVITIES ROW -->
<div class="row g-4 mb-4">
    <!-- Chart: Revenue Trend -->
    <div class="col-12 col-lg-8">
        <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">Tiến độ Doanh thu Ký kết</h5>
                    <small class="text-muted">Biểu đồ giá trị hợp đồng được ký qua các tháng gần nhất (Triệu VNĐ)</small>
                </div>
                <span class="badge bg-primary-light text-primary px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-chart-area me-1"></i> 6 Tháng qua
                </span>
            </div>
            <div style="position: relative; min-height: 280px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Recent System Activities Feed -->
    <div class="col-12 col-lg-4">
        <div class="glass-card p-4 h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">Hoạt động gần đây</h5>
                <span class="badge bg-light text-muted border">Tự động Audit</span>
            </div>
            
            @if (ViewBag.RecentActivities != null)
            {
                <div class="d-flex flex-column gap-3 my-auto">
                    @foreach (var activity in (List<AI_CRM.Domain.Entities.NhatKyHeThong>)ViewBag.RecentActivities)
                    {
                        string iconClass = "fa-circle-info text-primary";
                        string bgClass = "bg-primary-light";
                        var actionUpper = activity.Action.ToUpper();
                        if (actionUpper.Contains("THÊM") || actionUpper.Contains("TẠO") || actionUpper.Contains("INSERT")) { iconClass = "fa-plus-circle text-success"; bgClass = "bg-success-light"; }
                        else if (actionUpper.Contains("SỬA") || actionUpper.Contains("CẬP NHẬT") || actionUpper.Contains("UPDATE")) { iconClass = "fa-pen-to-square text-warning"; bgClass = "bg-warning-light"; }
                        else if (actionUpper.Contains("XÓA") || actionUpper.Contains("LỖI") || actionUpper.Contains("DELETE")) { iconClass = "fa-triangle-exclamation text-danger"; bgClass = "bg-danger-light"; }
                        else if (actionUpper.Contains("ĐĂNG NHẬP") || actionUpper.Contains("LOGIN")) { iconClass = "fa-right-to-bracket text-info"; bgClass = "bg-info-light"; }

                        var timeSpan = DateTime.Now - activity.Timestamp;
                        string timeStr = timeSpan.TotalMinutes < 60 ? $"{(int)timeSpan.TotalMinutes} phút trước" : 
                                         timeSpan.TotalHours < 24 ? $"{(int)timeSpan.TotalHours} giờ trước" : 
                                         $"{(int)timeSpan.TotalDays} ngày trước";

                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon @bgClass shadow-sm" style="width: 40px; height: 40px; font-size: 1rem; flex-shrink: 0; border-radius: 10px;">
                                <i class="fa-solid @iconClass"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 fw-bold text-dark text-truncate" style="font-size: 0.9rem;">@activity.Action</h6>
                                    <small class="text-secondary" style="font-size: 0.72rem;">@timeStr</small>
                                </div>
                                <p class="text-muted small mb-0 text-truncate" title="@activity.Details" style="font-size: 0.8rem;">
                                    @activity.Details
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
            
            <div class="mt-3 pt-3 border-top">
                <a href="@Url.Action("SystemLogs", "Admin")" class="btn btn-light text-primary fw-medium w-100 rounded-pill py-2 shadow-none border">
                    <i class="fa-solid fa-list-ul me-1"></i> Xem toàn bộ nhật ký hệ thống
                </a>
            </div>
        </div>
    </div>
</div>

