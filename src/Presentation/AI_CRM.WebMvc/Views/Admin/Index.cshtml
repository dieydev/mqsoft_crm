@using Microsoft.EntityFrameworkCore
@inject AI_CRM.Infrastructure.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Tổng quan (Dashboard)";
    var today = DateTime.Today;

    // 1. Cảnh báo Hợp đồng: Hợp đồng sắp hết hạn trong vòng 60 ngày hoặc đã hết hạn gần đây mà chưa thanh lý
    var expiringContracts = await DbContext.HopDongs
        .Include(h => h.KhachHang)
        .Include(h => h.TrangThaiHopDong)
        .Where(h => !h.IsDeleted && (h.TrangThaiHopDong == null || h.TrangThaiHopDong.StatusName != "Đã thanh lý"))
        .OrderBy(h => h.ExpireDate.HasValue ? h.ExpireDate.Value : DateTime.MaxValue)
        .Take(4)
        .ToListAsync();

    // 2. Cảnh báo Dự án: Dự án đang triển khai cần theo dõi tiến độ và deadline
    var attentionProjects = await DbContext.DuAns
        .Include(d => d.KhachHang)
        .Include(d => d.TrangThaiDuAn)
        .Include(d => d.TienDoDuAns)
        .Where(d => !d.IsDeleted && (d.TrangThaiDuAn == null || d.TrangThaiDuAn.StatusName != "Hoàn thành"))
        .OrderBy(d => d.Deadline.HasValue ? d.Deadline.Value : DateTime.MaxValue)
        .Take(4)
        .ToListAsync();

    // 3. Doanh số lũy kế (VNĐ)
    var totalContractRevenue = await DbContext.HopDongs
        .Where(h => !h.IsDeleted)
        .SumAsync(h => h.ContractValue ?? 0);
    string revenueFormatted = totalContractRevenue >= 1000000000 
        ? $"{(totalContractRevenue / 1000000000m):0.##} Tỷ" 
        : $"{(totalContractRevenue / 1000000m):0.##} Tr";
}

<!-- Top Header & Greeting -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-chart-line text-primary me-2"></i>Bảng Điều Khiển Quản Trị
        </h3>
        <p class="text-muted small mb-0">
            Hệ thống Quản lý Khách hàng Y tế & Tích hợp Trí tuệ Nhân tạo MQSoft • Hôm nay, @today.ToString("dd/MM/yyyy")
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="Chatbot" asp-action="Chat" class="btn rounded-pill px-3 py-2 text-white shadow-sm fw-medium d-flex align-items-center gap-2" style="background: linear-gradient(135deg, #6366f1, #ec4899); text-decoration: none;">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
            <span>Hỏi Trợ lý AI</span>
        </a>
        <a asp-controller="Report" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 shadow-sm fw-medium">
            <i class="fa-solid fa-file-excel me-1 text-success"></i> Xuất Báo cáo
        </a>
    </div>
</div>

